{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness source-design crosswalk record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sources",
    "design",
    "borrowing",
    "implementation",
    "acceptance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "design": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "relation",
          "path",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier for the linked design document, formatted as design:<public-root-relative-path>.",
            "pattern": "^design:.+"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:).+"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "resulting_design",
              "evaluation_framework",
              "reference_context"
            ],
            "description": "How the source relates to this design path: resulting_design means it informed the design; evaluation_framework means it was used to assess or organize evaluation without claiming it caused the design; reference_context means it supplies context, policy, or implementation identity."
          }
        }
      }
    },
    "borrowing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "mode",
        "evidence"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "locator"
            ],
            "properties": {
              "availability": {
                "enum": [
                  "public",
                  "private_archive"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "implementation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:).+"
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "status",
          "public_path",
          "result"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "public_path": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:).+"
              },
              {
                "type": "null"
              }
            ]
          },
          "archive_locator": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
