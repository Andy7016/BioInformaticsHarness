{
  "schema": "harness.research-preparation-design/v1",
  "decision_id": "D53",
  "date": "2026-10-22",
  "state": "implemented_guidance_and_record_contract",
  "placement": "A conditional preparation route in the existing methods layer; it reuses the source, measurement, resource-gap, plan-seal, study-unit and producer-consumer guides.",
  "routes": {
    "question_led": {
      "start": "A question is sufficiently formed to guide source selection.",
      "required": [
        "question_or_topic",
        "biological_object",
        "intended_use",
        "initial_scope"
      ],
      "may_end": [
        "review_delivered",
        "continue_targeted_reading",
        "defer",
        "stop",
        "transition_to_study"
      ]
    },
    "review_first": {
      "start": "The field's concepts, evidence relations or method choices need clarification before a focused study question is selected.",
      "required": [
        "initial_focus",
        "biological_object_or_topic",
        "review_purpose",
        "initial_scope"
      ],
      "may_end": [
        "review_delivered",
        "continue_targeted_reading",
        "defer",
        "stop",
        "transition_to_study"
      ],
      "exploration": "Search, reading and synthesis may iteratively focus. Record initial scope and concerns; version material changes to scope, selection rules or interpretation with their reasons; freeze the actual coverage snapshot at delivery."
    }
  },
