    "transition_decision": "transition_to_study",
    "must_record": [
      "reason and alternatives for the transition",
      "source-ledger and evidence-map versions",
      "selected question IDs and supporting finding IDs",
      "selected method ID linked to a method candidate in the evidence map",
      "data source criteria, version, access/license, entity and measurement semantics, availability, coverage and denominator",
      "information use and protected evaluation boundary",
      "owner, budget, stop and acceptance conditions",
      "first plan version and next unmet gate"
    ],
    "traceability_rules": [
      "Question IDs are unique within an evidence-map version.",
      "motivated_by_finding_ids reference finding_id values in the same evidence map.",
      "candidate_method_ids and selected_approach.method_id reference method_candidate.method_id values in that evidence map.",
      "Hypothesis question_ref values reference question_id values.",
      "Novelty scope references the coverage snapshot and search IDs used to bound any seen/unfound statement.",
      "A bridge records source_ledger_ref and evidence_map_ref as path/version pairs. Each selected_question_id references a question_id marked selected_for_study; selected_finding_ids reference finding_ids that motivate those questions; selected_approach.method_id references a selected method candidate in the referenced evidence-map version."
    ],
    "first_plan_required_sections": [
      "research identity and question",
      "selected method, assumptions, alternatives and change conditions",
      "data and evaluation requirements",
      "first actual action, audit and artifact seam",
      "resources, owner and stop conditions"
    ],
    "audit_rule": "If the first audit can change inclusion, deduplication, cleaning or split, seal the plan before that audit and capture the actual code/config/input and invocation using the existing first-execution guidance.",
    "seam_rule": "When a result will cross a program or person boundary, identify a real producer, saved artifact/version, formal reader and one downstream event; a fixture alone is not a completed seam."
  },
  "review_exit_policy": {
    "universal_paper_count_threshold": false,
    "exhaustive_search_required": false,
    "quantitative_synthesis_required": false,
    "causal_hypothesis_required": false,
    "readiness_basis": [
      "scope and actual coverage are clear",
      "critical sources and disagreements are covered enough for the stated review purpose",
      "remaining unknowns are visible",
      "additional evidence is judged by whether it could change the current synthesis or route"
    ],
    "review_may_be_delivered_without_study_transition": true
  },
  "interpretation_rules": {
    "templates_are_records_not_results": true,
    "retrieval_is_not_reading": true,
    "metadata_only_is_not_full_text_reading": true,
    "author_report_is_not_independent_acceptance": true,
    "publication_count_is_not_consensus": true,
    "shared_version_or_data_is_not_independent_replication": true,
    "unknown_is_not_negative": true,
    "no_automatic_scientific_acceptance": true
